# NiFi Diagnostics MCP — environment variables
#
# Copy this file to `.env` and fill in your own values, OR set these in your
# shell profile / your MCP client's "environment" block.
# NEVER commit real values — `.env` is git-ignored.

# Base URL of the NiFi REST API (single-user + self-signed cert supported)
NIFI_BASE_URL=https://localhost:8443

# NiFi single-user credentials.
# Used ONLY to obtain a session token internally — never exposed to the model.
NIFI_USERNAME=your-nifi-username
NIFI_PASSWORD=your-nifi-password

# Absolute path to the NiFi logs directory (read-only)
NIFI_LOG_DIR=/opt/nifi/logs
